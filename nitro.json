{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "razorpaynitro"
  ],
  "ios": {
    "iosModuleName": "RazorpayNitro"
  },
  "android": {
    "androidNamespace": [
      "razorpaynitro"
    ],
    "androidCxxLibName": "RazorpayNitro"
  },
  "autolinking": {
    "Razorpay": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridRazorpay"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridRazorpay"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
